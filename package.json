{
	"name": "malaxaco",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"preview": "npm run build && wrangler pages dev",
		"postinstall": "nuxt prepare",
		"deploy": "npm run build --preset=cloudflare_pages && wrangler pages deploy dist/",
		"cf-typegen": "wrangler types",
		"db:schema": "wrangler d1 execute malaxaco-db --local --file=./db/schema.sql",
		"db:seed": "wrangler d1 execute malaxaco-db --local --file=./db/seed.sql",
		"db:reset": "rm -rf .wrangler/state && npm run db:schema && npm run db:seed"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.1.17",
		"nuxt": "^4.6.0",
		"nuxt-auth-utils": "^0.5.31",
		"tailwindcss": "^4.1.17",
		"vue": "^3.5.25",
		"vue-router": "^4.6.3"
	},
	"devDependencies": {
		"@golar/vue": "^0.1.10",
		"@typescript/typescript6": "^6.0.2",
		"golar": "^0.1.10",
		"nitro-cloudflare-dev": "^0.2.2",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"typescript": "^6.0.3",
		"vue-tsc": "^3.3.12",
		"wrangler": "^4.50.0"
	}
}
